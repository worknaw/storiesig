# Instagram Cookie สำหรับดึงข้อมูล (ดูวิธีดึงค่าได้ใน implementation_plan.md)
# คัดลอกค่า Cookie จาก Developer Tools -> Network -> Request Headers -> Cookie
# แล้ววางลงในบรรทัดด้านล่าง (ห้ามมีเครื่องหมายขึ้นบรรทัดใหม่)
IG_COOKIE=mid=XXXXXX; ig_did=XXXXXX; csrftoken=XXXXXX; ds_user_id=XXXXXX; sessionid=XXXXXX;

# Port ของ Server (default: 3000)
PORT=3000

# Proxy URL (ไม่บังคับ - แนะนำให้ใช้สำหรับหลีกเลี่ยงการถูกแบน IP บน Render / Vercel)
# รูปแบบ: http://username:password@proxy-host:port หรือ http://proxy-host:port
# PROXY_URL=http://user:pass@127.0.0.1:8080
